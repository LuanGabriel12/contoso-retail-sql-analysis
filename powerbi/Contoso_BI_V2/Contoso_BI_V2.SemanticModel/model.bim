        "toTable": "DimDate",
        "toColumn": "DateKey",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "FactSales_DimProduct",
        "fromTable": "FactSales",
        "fromColumn": "ProductKey",
