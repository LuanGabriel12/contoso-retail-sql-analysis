{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "pt-BR",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"FactSales\",\"DimProduct\",\"DimStore\",\"DimDate\",\"DimChannel\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "tables": [
      {
        "name": "FactSales",
        "columns": [
          {
            "name": "SalesKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "SalesKey",
            "summarizeBy": "none"
          },
          {
            "name": "DateKey",
            "dataType": "dateTime",
            "isHidden": true,
            "formatString": "Short Date",
            "sourceColumn": "DateKey",
            "summarizeBy": "none"
          },
          {
            "name": "ChannelKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ChannelKey",
            "summarizeBy": "none"
          },
          {
            "name": "StoreKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "StoreKey",
            "summarizeBy": "none"
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ProductKey",
            "summarizeBy": "none"
          },
          {
            "name": "SalesQuantity",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "SalesQuantity",
            "summarizeBy": "sum"
          },
          {
            "name": "TotalCost",
            "dataType": "decimal",
            "isHidden": true,
            "formatString": "\"US$\" #,0.00",
            "sourceColumn": "TotalCost",
            "summarizeBy": "sum"
          },
          {
            "name": "SalesAmount",
            "dataType": "decimal",
            "isHidden": true,
            "formatString": "\"US$\" #,0.00",
            "sourceColumn": "SalesAmount",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Vendas Totais",
            "expression": "SUM(FactSales[SalesAmount])",
            "formatString": "\"US$\" #,0.00",
            "displayFolder": "01. KPIs Principais"
          },
          {
            "name": "Custo Total",
            "expression": "SUM(FactSales[TotalCost])",
            "formatString": "\"US$\" #,0.00",
            "displayFolder": "01. KPIs Principais"
          },
          {
            "name": "Unidades Vendidas",
            "expression": "SUM(FactSales[SalesQuantity])",
            "formatString": "#,0",
            "displayFolder": "01. KPIs Principais"
          },
          {
            "name": "Lucro Comercial",
            "expression": "[Vendas Totais] - [Custo Total]",
            "formatString": "\"US$\" #,0.00",
            "displayFolder": "01. KPIs Principais"
          },
          {
            "name": "Margem Comercial",
            "expression": "DIVIDE([Lucro Comercial], [Vendas Totais])",
            "formatString": "0.00%",
            "displayFolder": "01. KPIs Principais"
          },
          {
            "name": "Receita por Unidade",
            "expression": "DIVIDE([Vendas Totais], [Unidades Vendidas])",
            "formatString": "\"US$\" #,0.00",
            "displayFolder": "02. Indicadores Unitários"
          },
          {
            "name": "Custo por Unidade",
            "expression": "DIVIDE([Custo Total], [Unidades Vendidas])",
            "formatString": "\"US$\" #,0.00",
            "displayFolder": "02. Indicadores Unitários"
          },
          {
            "name": "Lucro por Unidade",
            "expression": "DIVIDE([Lucro Comercial], [Unidades Vendidas])",
            "formatString": "\"US$\" #,0.00",
            "displayFolder": "02. Indicadores Unitários"
          }
        ],
        "partitions": [
          {
            "name": "FactSales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Sql.Database(\"localhost\", \"ContosoRetailDW\"),",
                "    dbo_FactSales = Fonte{[Schema=\"dbo\",Item=\"FactSales\"]}[Data],",
                "    ColunasSelecionadas = Table.SelectColumns(dbo_FactSales,{\"SalesKey\", \"DateKey\", \"channelKey\", \"StoreKey\", \"ProductKey\", \"SalesQuantity\", \"TotalCost\", \"SalesAmount\"}),",
                "    ColunasRenomeadas = Table.RenameColumns(ColunasSelecionadas,{{\"channelKey\", \"ChannelKey\"}}),",
                "    TiposAlterados = Table.TransformColumnTypes(ColunasRenomeadas,{{\"SalesKey\", Int64.Type}, {\"DateKey\", type date}, {\"ChannelKey\", Int64.Type}, {\"StoreKey\", Int64.Type}, {\"ProductKey\", Int64.Type}, {\"SalesQuantity\", Int64.Type}, {\"TotalCost\", Currency.Type}, {\"SalesAmount\", Currency.Type}})",
                "in",
                "    TiposAlterados"
              ]
            }
          }
        ]
      },
      {
        "name": "DimProduct",
        "columns": [
          {
            "name": "ProductKey",
