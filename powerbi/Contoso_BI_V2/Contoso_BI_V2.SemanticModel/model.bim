            "sourceColumn": "ClassName",
            "summarizeBy": "none"
          },
          {
            "name": "ProductSubcategoryName",
            "dataType": "string",
            "sourceColumn": "ProductSubcategoryName",
            "summarizeBy": "none"
          },
          {
            "name": "ProductCategoryName",
            "dataType": "string",
            "sourceColumn": "ProductCategoryName",
            "summarizeBy": "none"
          },
          {
            "name": "UnitCost",
            "dataType": "decimal",
            "formatString": "\"US$\" #,0.00",
            "sourceColumn": "UnitCost",
            "summarizeBy": "none"
          },
          {
            "name": "UnitPrice",
            "dataType": "decimal",
            "formatString": "\"US$\" #,0.00",
            "sourceColumn": "UnitPrice",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimProduct",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Sql.Database(\"localhost\", \"ContosoRetailDW\"),",
                "    dbo_DimProduct = Fonte{[Schema=\"dbo\",Item=\"DimProduct\"]}[Data],",
                "    dbo_DimSub = Fonte{[Schema=\"dbo\",Item=\"DimProductSubcategory\"]}[Data],",
                "    dbo_DimCat = Fonte{[Schema=\"dbo\",Item=\"DimProductCategory\"]}[Data],",
                "    ProdColunas = Table.SelectColumns(dbo_DimProduct,{\"ProductKey\", \"ProductName\", \"BrandName\", \"ClassName\", \"ProductSubcategoryKey\", \"UnitCost\", \"UnitPrice\"}),",
                "    SubColunas = Table.SelectColumns(dbo_DimSub,{\"ProductSubcategoryKey\", \"ProductSubcategoryName\", \"ProductCategoryKey\"}),",
                "    CatColunas = Table.SelectColumns(dbo_DimCat,{\"ProductCategoryKey\", \"ProductCategoryName\"}),",
                "    MesclaSub = Table.NestedJoin(ProdColunas, {\"ProductSubcategoryKey\"}, SubColunas, {\"ProductSubcategoryKey\"}, \"Sub\", JoinKind.LeftOuter),",
                "    ExpandeSub = Table.ExpandTableColumn(MesclaSub, \"Sub\", {\"ProductSubcategoryName\", \"ProductCategoryKey\"}, {\"ProductSubcategoryName\", \"ProductCategoryKey\"}),",
                "    MesclaCat = Table.NestedJoin(ExpandeSub, {\"ProductCategoryKey\"}, CatColunas, {\"ProductCategoryKey\"}, \"Cat\", JoinKind.LeftOuter),",
                "    ExpandeCat = Table.ExpandTableColumn(MesclaCat, \"Cat\", {\"ProductCategoryName\"}, {\"ProductCategoryName\"}),",
                "    RemoveChavesAux = Table.RemoveColumns(ExpandeCat,{\"ProductSubcategoryKey\", \"ProductCategoryKey\"}),",
                "    TextoLimpo = Table.TransformColumns(RemoveChavesAux,{{\"ProductName\", Text.Trim, type text}, {\"BrandName\", Text.Trim, type text}, {\"ClassName\", Text.Trim, type text}, {\"ProductSubcategoryName\", Text.Trim, type text}, {\"ProductCategoryName\", Text.Trim, type text}}),",
                "    TiposAlterados = Table.TransformColumnTypes(TextoLimpo,{{\"ProductKey\", Int64.Type}, {\"UnitCost\", Currency.Type}, {\"UnitPrice\", Currency.Type}})",
                "in",
                "    TiposAlterados"
              ]
            }
          }
        ]
      },
      {
