          },
          {
            "name": "EmployeeCount",
            "dataType": "int64",
            "sourceColumn": "EmployeeCount",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimStore",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Sql.Database(\"localhost\", \"ContosoRetailDW\"),",
                "    dbo_DimStore = Fonte{[Schema=\"dbo\",Item=\"DimStore\"]}[Data],",
                "    ColunasSelecionadas = Table.SelectColumns(dbo_DimStore,{\"StoreKey\", \"StoreName\", \"StoreType\", \"Status\", \"OpenDate\", \"CloseDate\", \"EmployeeCount\"}),",
                "    TextoLimpo = Table.TransformColumns(ColunasSelecionadas,{{\"StoreName\", Text.Trim, type text}, {\"StoreType\", Text.Trim, type text}, {\"Status\", Text.Trim, type text}}),",
                "    TiposAlterados = Table.TransformColumnTypes(TextoLimpo,{{\"StoreKey\", Int64.Type}, {\"OpenDate\", type date}, {\"CloseDate\", type date}, {\"EmployeeCount\", Int64.Type}})",
                "in",
                "    TiposAlterados"
              ]
            }
          }
        ]
      },
      {
        "name": "DimDate",
        "dataCategory": "Time",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "dateTime",
            "isKey": true,
            "formatString": "Short Date",
            "sourceColumn": "DateKey",
            "summarizeBy": "none"
          },
          {
            "name": "CalendarYear",
            "dataType": "int64",
            "sourceColumn": "CalendarYear",
            "summarizeBy": "none"
          },
          {
            "name": "CalendarQuarterLabel",
            "dataType": "string",
            "sourceColumn": "CalendarQuarterLabel",
            "summarizeBy": "none"
          },
          {
            "name": "NumeroMes",
            "dataType": "int64",
            "sourceColumn": "NumeroMes",
            "summarizeBy": "none"
          },
          {
            "name": "CalendarMonthLabel",
            "dataType": "string",
            "sourceColumn": "CalendarMonthLabel",
            "sortByColumn": "NumeroMes",
            "summarizeBy": "none"
          },
          {
            "name": "MesAbrev",
            "dataType": "string",
            "sourceColumn": "MesAbrev",
            "sortByColumn": "NumeroMes",
            "summarizeBy": "none"
          },
          {
            "name": "AnoMesNumero",
            "dataType": "int64",
            "sourceColumn": "AnoMesNumero",
            "summarizeBy": "none"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "sourceColumn": "AnoMes",
            "sortByColumn": "AnoMesNumero",
            "summarizeBy": "none"
          },
          {
            "name": "InicioMes",
            "dataType": "dateTime",
            "formatString": "yyyy-MM",
            "sourceColumn": "InicioMes",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Sql.Database(\"localhost\", \"ContosoRetailDW\"),",
                "    dbo_DimDate = Fonte{[Schema=\"dbo\",Item=\"DimDate\"]}[Data],",
                "    ColunasSelecionadas = Table.SelectColumns(dbo_DimDate,{\"Datekey\", \"CalendarYear\", \"CalendarQuarterLabel\", \"CalendarMonth\", \"CalendarMonthLabel\"}),",
                "    ColunasRenomeadas = Table.RenameColumns(ColunasSelecionadas,{{\"Datekey\", \"DateKey\"}, {\"CalendarMonth\", \"AnoMesNumero\"}}),",
                "    TiposIniciais = Table.TransformColumnTypes(ColunasRenomeadas,{{\"DateKey\", type date}, {\"CalendarYear\", Int64.Type}, {\"AnoMesNumero\", Int64.Type}}),",
                "    PeriodoFactSales = Table.SelectRows(TiposIniciais, each [CalendarYear] >= 2007 and [CalendarYear] <= 2009),",
                "    AddNumeroMes = Table.AddColumn(PeriodoFactSales, \"NumeroMes\", each Date.Month([DateKey]), Int64.Type),",
                "    AddMesAbrev = Table.AddColumn(AddNumeroMes, \"MesAbrev\", each Date.ToText([DateKey], \"MMM\", \"pt-BR\"), type text),",
                "    AddAnoMes = Table.AddColumn(AddMesAbrev, \"AnoMes\", each Date.ToText([DateKey], \"yyyy-MM\"), type text),",
                "    AddInicioMes = Table.AddColumn(AddAnoMes, \"InicioMes\", each Date.StartOfMonth([DateKey]), type date)",
                "in",
                "    AddInicioMes"
              ]
            }
          }
        ]
      },
      {
