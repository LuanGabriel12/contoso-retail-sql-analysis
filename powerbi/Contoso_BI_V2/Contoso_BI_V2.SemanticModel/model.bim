              "expression": [
                "let",
                "    Fonte = Sql.Database(\"localhost\", \"ContosoRetailDW\"),",
                "    dbo_DimChannel = Fonte{[Schema=\"dbo\",Item=\"DimChannel\"]}[Data],",
                "    ColunasSelecionadas = Table.SelectColumns(dbo_DimChannel,{\"ChannelKey\", \"ChannelName\", \"ChannelDescription\"}),",
                "    TextoLimpo = Table.TransformColumns(ColunasSelecionadas,{{\"ChannelName\", Text.Trim, type text}, {\"ChannelDescription\", Text.Trim, type text}}),",
                "    TiposAlterados = Table.TransformColumnTypes(TextoLimpo,{{\"ChannelKey\", Int64.Type}})",
                "in",
                "    TiposAlterados"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
